import CircularLaw.BernoulliPrefixFreshLaw
import Mathlib.Probability.Process.Filtration

/-!
# The filtration generated by the currently exposed rectangular prefix

Larger prefixes reveal every smaller prefix. This gives an actual
filtration for any increasing rectangular exposure schedule. Functions
and events of the exposed entries are measurable in that filtration,
even when their deterministic definitions involve singular values.
-/

noncomputable section
open Classical MeasureTheory
open scoped NNReal

namespace CircularLaw

def bernoulliPrefixSample {N a m : ℕ} (ha : a ≤ N) (hm : m ≤ N)
    (x : BernoulliSquareSample N) : Fin a × Fin m → Bool :=
  fun ij => x (bernoulliPrefixEntryEmbedding ha hm ij)

def bernoulliPrefixSigmaAlgebra {N a m : ℕ} (ha : a ≤ N) (hm : m ≤ N) :
    MeasurableSpace (BernoulliSquareSample N) :=
  MeasurableSpace.comap (bernoulliPrefixSample ha hm) inferInstance

theorem bernoulli_prefix_sample_restriction {N a m b k : ℕ}
    (ha : a ≤ N) (hm : m ≤ N) (hb : b ≤ N) (hk : k ≤ N)
    (hab : a ≤ b) (hmk : m ≤ k) (x : BernoulliSquareSample N) :
    bernoulliPrefixSample ha hm x =
      fun ij => bernoulliPrefixSample hb hk x (Fin.castLE hab ij.1, Fin.castLE hmk ij.2) := rfl

theorem bernoulli_prefix_sigma_algebra_le {N a m : ℕ} (ha : a ≤ N) (hm : m ≤ N) :
    bernoulliPrefixSigmaAlgebra ha hm ≤
      (inferInstance : MeasurableSpace (BernoulliSquareSample N)) :=
  (measurable_of_countable (bernoulliPrefixSample ha hm)).comap_le

theorem bernoulli_prefix_sigma_algebra_mono {N a m b k : ℕ}
    (ha : a ≤ N) (hm : m ≤ N) (hb : b ≤ N) (hk : k ≤ N)
    (hab : a ≤ b) (hmk : m ≤ k) :
    bernoulliPrefixSigmaAlgebra ha hm ≤ bernoulliPrefixSigmaAlgebra hb hk := by
  have hRead : Measurable[bernoulliPrefixSigmaAlgebra hb hk]
      (bernoulliPrefixSample ha hm) := by
    exact (measurable_of_countable (fun u : Fin b × Fin k → Bool =>
      fun ij : Fin a × Fin m => u (Fin.castLE hab ij.1, Fin.castLE hmk ij.2))).comp
        (comap_measurable (bernoulliPrefixSample hb hk))
  exact hRead.comap_le

theorem measurable_bernoulli_prefix_function {N a m : ℕ} {β : Type*}
    [MeasurableSpace β] (ha : a ≤ N) (hm : m ≤ N)
    (f : (Fin a × Fin m → Bool) → β) :
    Measurable[bernoulliPrefixSigmaAlgebra ha hm]
      (fun x => f (bernoulliPrefixSample ha hm x)) :=
  (measurable_of_countable f).comp (comap_measurable (bernoulliPrefixSample ha hm))

theorem measurableSet_bernoulli_prefix_event {N a m : ℕ}
    (ha : a ≤ N) (hm : m ≤ N) (P : (Fin a × Fin m → Bool) → Prop) :
    MeasurableSet[bernoulliPrefixSigmaAlgebra ha hm]
      {x | P (bernoulliPrefixSample ha hm x)} :=
  ((Set.to_countable {u | P u}).measurableSet).preimage
    (comap_measurable (bernoulliPrefixSample ha hm))

def bernoulliRectangularPrefixFiltration {N : ℕ} (a m : ℕ → ℕ)
    (ha : ∀ s, a s ≤ N) (hm : ∀ s, m s ≤ N)
    (hMonoA : Monotone a) (hMonoM : Monotone m) :
    Filtration ℕ (inferInstance : MeasurableSpace (BernoulliSquareSample N)) where
  seq s := bernoulliPrefixSigmaAlgebra (ha s) (hm s)
  mono' _ _ hst := bernoulli_prefix_sigma_algebra_mono _ _ _ _ (hMonoA hst) (hMonoM hst)
  le' s := bernoulli_prefix_sigma_algebra_le (ha s) (hm s)

theorem measurable_bernoulli_rectangular_prefix_process {N : ℕ} {β : Type*}
    [MeasurableSpace β] (a m : ℕ → ℕ) (ha : ∀ s, a s ≤ N) (hm : ∀ s, m s ≤ N)
    (hMonoA : Monotone a) (hMonoM : Monotone m)
    (f : ∀ s, (Fin (a s) × Fin (m s) → Bool) → β) (s : ℕ) :
    Measurable[bernoulliRectangularPrefixFiltration a m ha hm hMonoA hMonoM s]
      (fun x => f s (bernoulliPrefixSample (ha s) (hm s) x)) :=
  measurable_bernoulli_prefix_function (ha s) (hm s) (f s)

end CircularLaw
